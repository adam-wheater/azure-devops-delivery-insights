{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // This is a bundled browser app, not a published library: nothing consumes
    // type declarations from the .vsix. Emitting them put 56 .d.ts/.d.ts.map
    // files into dist/, and because the manifest marks dist/ addressable, every
    // one became a published Marketplace asset. The .d.ts.map files also point at
    // src/ paths that are not shipped.
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
